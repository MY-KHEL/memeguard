# Copy to .env and fill in. Never commit real keys.

# --- Required locally (Phase 0) ---
# Postgres connection string. Docker Compose sets this for the containers.
DATABASE_URL=postgres://memeguard:memeguard@localhost:5432/memeguard
# Redis connection string. Docker Compose sets this for the containers.
REDIS_URL=redis://localhost:6379
# Port the worker health server listens on.
WORKER_PORT=4000
# URL the web app uses to reach the worker (server-side only).
WORKER_URL=http://localhost:4000

# --- Scanner (Phase 1, worker only) ---
# How often the worker discovers and refreshes coins. 20 s keeps DexScreener under its 60 rpm budget.
SCAN_INTERVAL_MS=20000
# Keep refreshing a coin for this many hours after first seen.
TRACK_WINDOW_HOURS=24
# Delete token_snapshots older than this.
SNAPSHOT_RETENTION_DAYS=7
# Also pull GeckoTerminal new_pools as a discovery source (adds ~1 call per cycle to a 30 rpm budget).
SCANNER_USE_GECKO_NEW_POOLS=false
# How often a token is re-evaluated, and how many reports to write per scanner cycle.
RISK_REFRESH_MINUTES=30
RISK_PER_CYCLE=8

# --- External providers (optional until the phase that uses them) ---
# Helius: RPC, DAS, parsed transactions, webhooks (Phase 1 and 2).
HELIUS_API_KEY=
# Birdeye: holders list, OHLCV candles, trending (Phase 1). Leave empty if using GeckoTerminal.
BIRDEYE_API_KEY=
# RugCheck: contract safety (Phase 2). Only needed if RugCheck requires a key for your usage tier.
RUGCHECK_API_KEY=
# Jupiter: sell-simulation quotes (Phase 2). Free key raises the limit from 0.5 rps to 1 rps.
JUPITER_API_KEY=

# --- Auth and paper trading (Phase 3) ---
# HMAC secret for the httpOnly session cookie. Required by the web app.
SESSION_SECRET=change-me-to-a-long-random-string
# Local only. A Solana address to sign in without a wallet extension. Ignored when NODE_ENV=production.
DEV_WALLET=
# Worker live-quote loop. Defaults match packages/trading/trading-config.json.
LIVE_QUOTE_INTERVAL_MS=1000
LIVE_MAX_WATCHED=90
# Phase 4 jobs. Defaults: regime 30m, outcomes 5m, alerts 15s.
REGIME_INTERVAL_MS=1800000
OUTCOME_INTERVAL_MS=300000
ALERT_INTERVAL_MS=15000
# Optional. Restricts GET /api/calibration in production.
CALIBRATION_ADMIN_WALLET=
# Optional CoinGecko demo key (x-cg-demo-api-key). Public OHLC works without it at a lower limit.
COINGECKO_API_KEY=

# Base URL overrides. Leave empty. Point at an unreachable host to simulate a provider outage locally.
DEXSCREENER_BASE_URL=
GECKOTERMINAL_BASE_URL=
BIRDEYE_BASE_URL=
HELIUS_RPC_URL=
HELIUS_API_URL=
RUGCHECK_BASE_URL=
JUPITER_BASE_URL=
