{
  "name": "meme-guard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "dotenv -e .env -- pnpm --filter @meme-guard/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @meme-guard/db migrate"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
